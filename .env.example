# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Pose (PRD §7.7). Defaults to the HuggingFace copy of instanthmr.onnx.
# NEXT_PUBLIC_MODEL_URL=https://huggingface.co/momolesang/InstantHMR/resolve/main/instanthmr.onnx
# NEXT_PUBLIC_POSE_BACKEND=instanthmr   # instanthmr | remote | mediapipe
